{
  "name": "@repo/mini-ecommerce-backend",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": " tsc && tsx scripts/generate-types.ts",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/src/index.js",
    "seed": "node prisma/seed.js",
    "types": "dist-types/types.d.ts",
    "build:types": "tsc -p tsconfig.types.json"
  },
  "exports": {
    "./types": {
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    }
  },
  "dependencies": {
    "@faker-js/faker": "^10.3.0",
    "@repo/db": "workspace:*",
    "@trpc/server": "^11.9.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pexels": "^1.4.0",
    "pg": "^8.18.0",
    "razorpay": "^2.9.6",
    "slugify": "^1.6.6",
    "trpc-to-openapi": "^3.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "prisma": "^7.3.0",
    "tsc-watch": "^7.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.2"
  }
}
